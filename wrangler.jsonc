{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pilk-polymarket",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  // Keep variables set in the Cloudflare dashboard (BOT_ALLOCATION, BOT_MAX_BET, BTC_STREAM,
  // LIVE_TRADING) when Git pushes deploy; without this every deploy would wipe them.
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  // Live game feed: one Durable Object that loops every 5 s while games are live.
  // Crypto feed: bitcoin Up or Down windows around the clock, every 5 s.
  // Cricket feed (Nov 25): cricket match-winner markets, every 3 s while a match is live. Paper only.
  "durable_objects": { "bindings": [{ "name": "LIVE", "class_name": "LiveFeed" }, { "name": "CRYPTO", "class_name": "CryptoFeed" }, { "name": "CRICKET_FEED", "class_name": "CricketFeed" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveFeed"] }, { "tag": "v2", "new_sqlite_classes": ["CryptoFeed"] }, { "tag": "v3", "new_sqlite_classes": ["CricketFeed"] }],
  "d1_databases": [
    { "binding": "DB", "database_name": "pilk-polymarket", "database_id": "43cb2ffb-75a3-4472-9b28-41b2a9429ea0" }
  ],
  // Every minute: record live game prices. Every 15 minutes: sync trades and settle games.
  "triggers": { "crons": ["* * * * *"] }
  // Secrets (set with `npx wrangler secret put NAME`, never in this file):
  //   POLYMARKET_KEY_ID, POLYMARKET_SECRET_KEY, DASH_PASSWORD, SESSION_SECRET
}
